# ============================================================
#  Claw // 乌波极限挑战 v3.0  —  .gitignore
#  设计原则：数据与系统分离
#    ✅ 入库：源代码、配置模板、文档、导入/生成脚本
#    ❌ 不入：真实数据库、备份、生成的表格/文档、
#             密钥(.env)、第三方程序(napcat/python-embed)、运行缓存
# ============================================================

# ---------- 1. 密钥（绝不可入库） ----------
Claw/.env

# ---------- 2. 真实数据库与所有备份 ----------
Claw/data/*.db
Claw/data/*.db.bak*
Claw/data/*_bak_*.db
Claw/data/_*.db
Claw/data/backup_v3_original/

# ---------- 3. 生成的游戏数据（Excel / Word / 图片 / 日志） ----------
# 这些是“数据产物”，由 data/ 下的 gen_*.py 脚本生成，不随源码版本管理。
Claw/data/*.xlsx
Claw/data/*.docx
Claw/data/*.png
# 日志（任何位置产生的 *.log 都不入库）
*.log

# ---------- 4. Python 运行缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- 5. 第三方程序 / 运行时（下载物，非源码） ----------
# NapCat 是 GitHub 上的受限再分发程序，单独下载，不入库
napcat/
# 嵌入式 Python 便携运行时，单独放置，不入库
python-embed/

# ---------- 6. 编辑器 / 系统垃圾 ----------
*.bak*
*.tmp
*.swp
Thumbs.db
.DS_Store
