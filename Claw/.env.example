# ============================================================
#  Claw // 乌波极限挑战 v3.0  —  .env 配置模板
#  用法：复制本文件为 .env，填入真实值后保存。
#        .env 已被 .gitignore 忽略，不会进入 Git 仓库。
# ============================================================

# NoneBot 驱动（一般保持不变）
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080

# OneBot 连接配置（NapCat 反向 WS 连接到 NoneBot；一般留空）
ONEBOT_WS_URLS=[]

# 管理员 QQ 号（逗号分隔；Web 管理页不可修改，只能在此配置）
ADMIN_QQ=

# Web 管理页访问令牌（Bearer Token，必填；为空则所有 /api/* 接口返回 401，Web 页无法使用）
# 建议用 32 位以上随机串，例如：openssl rand -hex 24
ADMIN_TOKEN=

# 游戏 QQ 群号（玩家在此群查询状态）
GAME_GROUP=

# 工作/对接 QQ 群号（猎人、任务点NPC 在此群发指令）
WORK_GROUP=

# 后台 QQ 群号（管理员在此群发管理指令）
BACKEND_GROUP=

# QQ Bot 小号（NapCat 登录的 QQ 号）
BOT_QQ=

# 金山文档 Open API 配置（可选，不填则仅使用本地数据库）
KDOCS_APP_ID=
KDOCS_APP_SECRET=
KDOCS_FILE_ID=

# 数据库路径
DB_PATH=./data/claw.db
